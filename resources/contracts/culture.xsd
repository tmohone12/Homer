<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:annotation><xs:documentation>
    Homer culture prompt projection, version 1. Canonical campaign Markdown is
    authoritative. XSD validates structure, not knowledge access or behavior.
    Resolve references and inheritance, filter visibility, and budget before rendering.
  </xs:documentation></xs:annotation>
  <xs:simpleType name="Text"><xs:restriction base="xs:token"><xs:minLength value="1"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="Kind"><xs:restriction base="xs:string">
    <xs:enumeration value="values"/><xs:enumeration value="status"/>
    <xs:enumeration value="etiquette"/><xs:enumeration value="speech"/>
    <xs:enumeration value="custom"/><xs:enumeration value="taboo"/>
    <xs:enumeration value="worldview"/>
  </xs:restriction></xs:simpleType>
  <xs:complexType name="Source">
    <xs:attribute name="document" type="Text" use="required"/>
    <xs:attribute name="anchor" type="Text" use="required"/>
    <xs:attribute name="revision" type="Text" use="required"/>
  </xs:complexType>
  <xs:complexType name="Scope">
    <xs:attribute name="region" type="Text"/>
    <xs:attribute name="era" type="Text"/>
    <xs:attribute name="social_group" type="Text"/>
    <xs:attribute name="situation" type="Text"/>
  </xs:complexType>
  <xs:complexType name="Cue">
    <xs:sequence>
      <xs:element name="applies" type="Scope"/>
      <xs:element name="behavior" type="Text"/>
      <xs:element name="exception" type="Text" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="source" type="Source" minOccurs="0"/>
    </xs:sequence>
    <xs:attribute name="id" type="xs:NCName" use="required"/>
    <xs:attribute name="kind" type="Kind" use="required"/>
    <xs:attribute name="salience" default="medium"><xs:simpleType><xs:restriction base="xs:string">
      <xs:enumeration value="high"/><xs:enumeration value="medium"/><xs:enumeration value="low"/>
    </xs:restriction></xs:simpleType></xs:attribute>
  </xs:complexType>
  <xs:complexType name="Norm">
    <xs:simpleContent><xs:extension base="Text">
      <xs:attribute name="kind" type="Kind" use="required"/>
    </xs:extension></xs:simpleContent>
  </xs:complexType>
  <xs:complexType name="Variant">
    <xs:sequence>
      <xs:element name="scope" type="Scope"/>
      <xs:element name="norm" type="Norm" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="cue" type="Cue" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="id" type="xs:NCName" use="required"/>
  </xs:complexType>
  <xs:complexType name="Culture">
    <xs:sequence>
      <xs:element name="source" type="Source"/>
      <xs:element name="scope" type="Scope" minOccurs="0"/>
      <xs:element name="inherits" minOccurs="0" maxOccurs="unbounded"><xs:complexType>
        <xs:attribute name="culture_ref" type="xs:NCName" use="required"/>
      </xs:complexType></xs:element>
      <xs:element name="related" minOccurs="0" maxOccurs="unbounded"><xs:complexType>
        <xs:attribute name="kind" type="Text" use="required"/>
        <xs:attribute name="ref" type="Text" use="required"/>
      </xs:complexType></xs:element>
      <xs:element name="norm" type="Norm" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="cue" type="Cue" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="variant" type="Variant" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="id" type="xs:NCName" use="required"/>
    <xs:attribute name="name" type="Text" use="required"/>
    <xs:attribute name="revision" type="Text" use="required"/>
  </xs:complexType>
  <xs:complexType name="Affiliation">
    <xs:attribute name="culture_ref" type="xs:NCName" use="required"/>
    <xs:attribute name="variant_ref" type="xs:NCName"/>
    <xs:attribute name="relation" use="required"><xs:simpleType><xs:restriction base="xs:string">
      <xs:enumeration value="upbringing"/><xs:enumeration value="membership"/><xs:enumeration value="exposure"/>
    </xs:restriction></xs:simpleType></xs:attribute>
    <xs:attribute name="familiarity" type="Text" use="required"/>
    <xs:attribute name="identification" type="Text" use="required"/>
  </xs:complexType>
  <xs:complexType name="Deviation">
    <xs:simpleContent><xs:extension base="Text">
      <xs:attribute name="culture_ref" type="xs:NCName" use="required"/>
      <xs:attribute name="cue_ref" type="xs:NCName" use="required"/>
    </xs:extension></xs:simpleContent>
  </xs:complexType>
  <xs:element name="culture_context">
    <xs:complexType><xs:sequence>
      <xs:element name="cultures"><xs:complexType><xs:sequence>
        <xs:element name="culture" type="Culture" minOccurs="0" maxOccurs="unbounded">
          <xs:unique name="cueIdWithinCulture"><xs:selector xpath=".//cue"/><xs:field xpath="@id"/></xs:unique>
          <xs:unique name="variantIdWithinCulture"><xs:selector xpath="variant"/><xs:field xpath="@id"/></xs:unique>
        </xs:element>
      </xs:sequence></xs:complexType></xs:element>
      <xs:element name="character"><xs:complexType><xs:sequence>
        <xs:element name="affiliation" type="Affiliation" minOccurs="0" maxOccurs="unbounded"/>
        <xs:element name="deviation" type="Deviation" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence><xs:attribute name="id" type="xs:NCName" use="required"/></xs:complexType></xs:element>
    </xs:sequence>
      <xs:attribute name="schema_version" type="xs:string" use="required" fixed="1"/>
      <xs:attribute name="projection" type="xs:string" use="required" fixed="prompt"/>
      <xs:attribute name="trust" type="xs:string" use="required" fixed="data"/>
    </xs:complexType>
    <xs:unique name="cultureId"><xs:selector xpath="cultures/culture"/><xs:field xpath="@id"/></xs:unique>
  </xs:element>
</xs:schema>
